{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QueueFlight",
  "version": "0.1.0",
  "identifier": "dev.okantiktas.queueflight",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QueueFlight \u2014 SQS workbench",
        "width": 1400,
        "height": 980,
        "minWidth": 780,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
